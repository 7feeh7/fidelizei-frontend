# Modelo das variáveis de ambiente.
# Para sobrescrever localmente sem commitar, crie .env.development.local (ou .env.<modo>.local).

# URL base da API, com "/" no final. O cliente HTTP monta: <URL>v1/
VITE_APP_API_URL=http://localhost:8000/

# true = login e serviços usam dados falsos (útil para rodar sem backend)
VITE_APP_MOCK_API=false
